{
  "name": "@ecomkit/inventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./schema": "./src/schema.ts",
    "./domain": "./src/domain/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./admin": "./src/admin/index.ts",
    "./routes/*": "./src/routes/*.tsx",
    "./mocks/*": "./src/mocks/*.ts",
    "./messages": "./src/messages.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ecomkit/catalog": "workspace:*",
    "@ecomkit/core": "workspace:*",
    "@ecomkit/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
