# Copy to apps/shop/.env (never commit .env). Single-quote any value containing # $ ( or spaces.

# --- database (Postgres 17; on the build Mac it listens on 5433, 5432 is Postgres 15) ---
# Runtime app role: no DDL, INSERT+SELECT only on core_audit_log.
DATABASE_URL='postgres://ecom_app:change-me@localhost:5433/ecomkit_shop'
# Owner role for migrations (deploy step only).
DATABASE_OWNER_URL='postgres://ecom_owner:change-me@localhost:5433/ecomkit_shop'
# Admin connection used by `pnpm db:fresh` (throwaway databases); defaults probe 5432 then 5433 for a 17+ server.
DATABASE_ADMIN_URL='postgres://localhost:5433/postgres'

# --- site ---
# Canonical origin: proxy.ts 301s every other host/scheme here; metadataBase and sitemaps use it. Unset in local dev.
SITE_URL='https://www.example.com'
GIT_SHA=''

# --- secrets (generate with: openssl rand -base64 32) ---
# AES-256-GCM key for encrypted settings; keep the previous key during rotation.
SETTINGS_MASTER_KEY=''
SETTINGS_MASTER_KEY_PREVIOUS=''
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=''
BETTER_AUTH_SECRET=''
BETTER_AUTH_URL='http://localhost:3000'
# HMAC for the worker -> /api/internal/revalidate call (localhost only).
INTERNAL_REVALIDATE_SECRET=''

# --- agency Gmail OAuth client (shared); each site connects its mailbox in admin ---
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''

# --- dev and test only ---
# Mock route handlers answer only when this is 1 (they are not generated at all in the prod config).
ENABLE_MOCKS='1'
# Extra script/connect sources for the storefront CSP until the marketing module supplies them.
CSP_VENDOR_SOURCES=''
