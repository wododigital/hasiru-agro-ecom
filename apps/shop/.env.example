# Hasiru Agro shop: server environment (keys only; real values live in the server's .env, never in git).
# The web process (next start / standalone server.js), the worker (worker.ts) and seed:load all read the same set.
# Quote any value that contains #, $ or spaces with single quotes.

# Postgres 17. App role at runtime (no DDL).
DATABASE_URL=
# Owner role: migrations, `pnpm jobs:install` and seed:load only. Falls back to DATABASE_URL when unset.
DATABASE_OWNER_URL=

# Canonical public origin, no trailing slash (e.g. https://shop.example.com). proxy.ts 301s every other host to it.
SITE_URL=
# Same origin for the browser bundle (optional; inlined at build time).
NEXT_PUBLIC_SITE_URL=
# Where the worker reaches the web process (tag revalidation, uptime check). Loopback, e.g. http://127.0.0.1:3000
INTERNAL_BASE_URL=

# 32+ random characters. Signs internal calls, guest order links, cart restore links, form tokens and contact hashes.
# Rotating it invalidates guest order links, restore links and stored contact hashes.
INTERNAL_SECRET=
# Seals secret settings (payment keys, API tokens): '1:<base64 of 32 random bytes>'.
SETTINGS_MASTER_KEY=
# The previous key while rotating (old secrets stay readable until re-saved).
SETTINGS_MASTER_KEY_PREVIOUS=

# Absolute path to persistent media storage, shared by web, worker and seed:load.
MEDIA_ROOT=

# Agency Gmail OAuth client (per-site refresh token comes from the admin "Connect Gmail" button).
# Redirect URI to register: <SITE_URL>/api/auth/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Extra script/connect sources for the static CSP (space separated), until marketing supplies them.
CSP_VENDOR_SOURCES=
# Build id for deployment skew protection (set by the deploy script).
GIT_SHA=

# Local development and smoke runs only. 1 swaps PhonePe, Gmail, WhatsApp and hasiru-ops for in-process mocks.
ENABLE_MOCKS=0
# Lets a production build (next start) serve mocks for a local smoke run. NEVER set this on a server.
ALLOW_MOCKS_IN_PROD=0
